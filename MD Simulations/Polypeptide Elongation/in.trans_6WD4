variable dir index ${iname}  # ${dir} is the PDB ID (e.g. 6WD4)
  
variable T equal 293

variable CON0 equal 100000 

label loop

# Generate 100 elongation trajectories in 6WD4 tunnel
variable n loop 1 100

units              real
boundary 	         p p p
atom_style         full
bond_style         harmonic
angle_style        harmonic     
pair_style         hybrid lj/cut 3.5 lj/cut/coul/cut 12      
dihedral_style     opls      
special_bonds      lj/coul 0.0 0.0 0.5    

region sys block 0.0 200.0 0.0 200.0 0.0 200.0

create_box 3 sys bond/types 1 angle/types 1 dihedral/types 1 extra/bond/per/atom 1 extra/angle/per/atom 2  extra/dihedral/per/atom 3

read_data  ${dir}/data.tunnel add append offset 0 0 0 0 0 

pair_coeff 1 1 lj/cut 0.066 3.5   

pair_coeff 1 2 lj/cut/coul/cut 0.08 3.5

pair_coeff 1 3 lj/cut/coul/cut 0.08 3.5

pair_coeff 2 2 lj/cut/coul/cut 0.066 3.5  
 
pair_coeff 2 3 lj/cut/coul/cut 0.066 3.5

pair_coeff 3 3 lj/cut/coul/cut 0.066 3.5


bond_coeff 1   268  1.529     
 
angle_coeff 1  300   112.7    

dihedral_coeff 1  1.3 -0.05 0.2 0  

mass * 12    


group tunnel type 1 

reset_atoms id sort yes

neigh_modify exclude type 1 1

# File containing the bead addition position and key parameters for the single bead
read_data  ${dir}/data.lj_${dir}_trans add append offset 1 0 0 0 0  

group nc type 2

compute www tunnel count/type atom

run 0

variable wall equal c_www[1]

variable chain equal ${wall}+1

variable chain2 equal ${chain}  

group target type 2

group c_ter id ${chain} 

group n_ter id ${chain2}

group rest subtract nc c_ter

neigh_modify exclude group rest c_ter

neigh_modify exclude group tunnel c_ter


timestep 1.0

thermo_style custom step temp press pe density cpu

thermo    1000

variable check equal 0

variable start timer

neigh_modify delay 0 every 1 check yes

min_style       sd

minimize        1.0e-8 1.0e-6 1000 1000


fix         1   rest nvt temp ${T} ${T} 10

run         1000                   

label loopa

variable a loop 3000   # so 1.5E7 fs in total (around 10 ns)

# The direction (x,y,z) of the total ~1 displacement is determined by the vector from the PTC to the tunnel exit port.
displace_atoms nc random 1 -0.5 0 10086 units box

read_data  ${dir}/data.lj_${dir}_trans add append offset 2 0 0 0 0 group nc

group nc type 2 3

group c_ter delete

group n_ter delete

variable wall equal c_www[1]

variable chain equal ${wall}+1

variable chain2 equal ${chain}+${a}   

variable chain3 equal ${chain2}-1

variable chain4 equal ${chain2}-2


group c_ter id ${chain2} 

group n_ter id ${chain}

group rest subtract nc c_ter

create_bonds single/bond 1 ${chain2} ${chain3}

if " ${a} >= 2 " then &
  "create_bonds single/angle 1 ${chain2} ${chain3} ${chain4}"


if "${a} >= 1" then &
 "min_style       sd" &
 "minimize        1.0e-8 1.0e-6 1000 1000"&
 "fix 10 tunnel setforce 0.0 0.0 0.0"

variable seed equal 54634234+1000*${n}

velocity all create ${T} ${seed}       
                                         	 
run 0

velocity all scale ${T}

velocity tunnel zero linear

velocity tunnel zero angular

run         10000


# In this example, the polypeptide chain is extended to 60 beads, corresponding to a 20-amino-acid sequence.
if "${a} == 59" then "variable check equal 1"      # This ${a} parameter specifies the number of beads to be added to the chain.


variable nnnname equal ${a}+1

if " ${check} == 1 " then &
  "dump  1   nc custom 500 test/${dir}/${nnnname}_chain_${n}.lammpstrj id element x y z" &
  "run 10000" &
  "jump SELF break"

next a
jump   in.trans_${dir} loopa

label break

undump      1

variable    a delete 

variable stop timer

# Optional: Check the run time
print "Elapsed time: $(v_stop-v_start:%.6f)"

clear

next        n

jump SELF loop

quit



