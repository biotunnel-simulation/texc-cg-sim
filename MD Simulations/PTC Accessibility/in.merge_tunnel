variable dir index ${iname}

variable mer equal ${ilen}

variable T equal 293

variable CON0 equal 50000 


label loop

variable n loop 1 1

units              real
boundary 	   p p p
atom_style         full
bond_style         harmonic
angle_style        harmonic    
pair_style         lj/cut 3.5   
dihedral_style     opls              
special_bonds      lj/coul 0.0 0.0 0.5    

region sys block -1000.0 1000.0 -1000.0 1000.0 -1000.0 1000.0

create_box 1 sys bond/types 1 angle/types 1 dihedral/types 1 extra/bond/per/atom 1 extra/angle/per/atom 2  extra/dihedral/per/atom 3


read_data  more/${dir}/data.tunnel_${dir}_diff add append offset 0 0 0 0 0   #scale_v2

#read_data  ${dir}/data.sphere_2025_more add append offset 1 0 0 0 0  #data.4UG0_new_vertex (along vertex: more atoms for explicit water)


pair_coeff 1 1 0 3.5
#pair_coeff 2 2 0 3.5
#pair_coeff 1 2 0 3.5


bond_coeff 1  268  1.529      
 
angle_coeff 1  0   180    

dihedral_coeff 1  0   0   0   0         

mass * 12    

group tunnel type 1 #2

#group sphere type 2 #2

delete_atoms overlap 1.3 tunnel tunnel      

#delete_atoms overlap 2.8 tunnel sphere


neigh_modify exclude type 1 1

#neigh_modify exclude type 1 2
#neigh_modify exclude type 2 2

#delete_atoms group sphere

reset_atoms id sort yes

write_data more/${dir}/data.tunnel_check_diff    #should no #

timestep 1

thermo_style custom step temp press pe density  

thermo    1000

neigh_modify delay 0 every 1 check yes

min_style       sd

minimize        1.0e-8 1.0e-6 1000 1000


variable CON   equal   1000*($n)   


fix         1   tunnel nvt temp ${T} ${T} 10      #should has #

dump        1   tunnel atom 1000 more/${dir}/tunnel_diff.lammpstrj      #should has #


run         ${CON}                    



clear

next        n

jump SELF loop

quit



