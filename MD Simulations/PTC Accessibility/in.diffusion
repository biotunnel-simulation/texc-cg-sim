variable dir index ${iname}            # ${dir} is the PDB ID (e.g. 6WD4)

variable mer equal ${ilen}

variable displace equal ${idis}        # estimated distance from tunnel exit port to PTC

variable T equal 300


label loop

# Generate 20 trajectories
variable n loop 1 20

units              real
boundary 	         p p p
atom_style         full
bond_style         harmonic
angle_style        harmonic     
pair_style         lj/cut 3.5  
dihedral_style     opls               
special_bonds      lj/coul 0.0 0.0 0.5     

region sys block 0.0 1000.0 0.0 1000.0 0.0 1000.0

create_box 2 sys bond/types 1 angle/types 0 dihedral/types 0 extra/bond/per/atom 1 extra/angle/per/atom 0  extra/dihedral/per/atom 0

# Data file containing the modified tunnel structure with a closed exit port and an open PTC side
read_data  data.tunnel_diff_${dir} add append offset 0 0 0 0 0  


pair_coeff 1 1 0.066 3.5

pair_coeff 1 2 0.066 3.5      

pair_coeff 2 2 0.066 3.5

bond_coeff 1  268  4.7

mass 1 12    

mass 2 80    

group tunnel type 1

fix stop_tunnel tunnel setforce 0.0 0.0 0.0

reset_atoms id sort yes

neigh_modify exclude type 1 1
neigh_modify exclude type 2 2

# Data file containing the ligand's initial position near the tunnel exit port
read_data  data.${dir}_diff_${n} add append offset 1 0 0 0 0  

group nc type 2 

compute www tunnel count/type atom

run 0

variable wall equal c_www[1]

variable chain equal ${wall}+1

group target id ${chain} 

timestep 10


thermo_style custom step temp press pe density cpu


thermo    1000


neigh_modify delay 0 every 1 check yes

min_style       sd

minimize        1.0e-8 1.0e-6 1000 1000


variable seed equal 5463+1000*${n}

velocity all create ${T} ${seed}        
                                         	  
run 0                

velocity all scale ${T}

velocity tunnel zero linear

velocity tunnel zero angular


variable check equal 0

compute 3 target displace/atom 

fix         1   nc nve 

fix         0   nc rigid single langevin 300 300 16 54634234 


# m = 80*5 g/mol, N_A ≈ 6.022 × 10^{23} mol^{-1}, 
# diffusion coefficient in water γ = 0.1 × 10^{-9} m^2/s 
# real τ_damp = (m/Na) * D/ kT

dump        2   nc custom 1000 ${dir}/diffusion_${n}.lammpstrj id element x y z     # Ligand only
dump        4   tunnel custom 10000 ${dir}/tunnel_diff.lammpstrj id element x y z        # Tunnel only


label loopa
variable a loop 16000    # so 8E7 fs in total (around 8 ns)

run         5000

variable dsp equal C_3[v_chain][4]

if "${dsp} > ${displace}" then "variable check equal 1"

if " ${check} == 1 " then &
  "dump        3   nc custom 1000 ${dir}/unwrapped_${n}.txt id type xu yu zu" &
  "run 1000" &
  "jump SELF break"

next a
jump      in.diffusion loopa

run         1000

label       break
variable    a delete 

undump      4
undump      3
undump      2

unfix       1
unfix      stop_tunnel

# End of loop

clear

next        n

jump SELF loop

quit



